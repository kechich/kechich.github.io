# Dependencies
node_modules/

# Build output — regenerated by `npm run build`, and the host builds it itself
dist/
dist-ssr/

# Full-resolution source photos: kept locally, never served or published.
# _originals/gallery-1.jpeg alone is 19 MB — the whole reason this entry exists.
_originals/

# Vite
.vite/
*.local

# Secrets. Nothing in this project uses them today; this is here so that stays
# true. The Web3Forms access key is deliberately NOT secret — it is a
# submission-only key and has to be public in the HTML for the form to work.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Agent worktrees (.claude/launch.json is intentionally tracked — it is the
# project's dev-server config and useful to anyone who clones this)
.claude/worktrees/
.claude/settings.local.json

# Editors
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db
